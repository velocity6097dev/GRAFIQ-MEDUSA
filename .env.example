# grafiq-medusa/.env — copy to .env and fill in real values. Never commit
# the real .env (see .gitignore).

# ---------- Medusa core ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grafiq_medusa
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# ---------- Razorpay ----------
# Free test-mode keys, no verification needed: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT=
# Settings → Webhooks in the Razorpay dashboard, once deployed publicly.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Shiprocket ----------
# A dedicated API user under Shiprocket Panel → Settings → API → "Add New
# API User" — do NOT use your normal Shiprocket login here (same rule as
# the original grafiq-api setup).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must exactly match the "Nickname" of a pickup location already
# configured in your Shiprocket dashboard.
SHIPROCKET_PICKUP_LOCATION=Primary
# Secret for the plugin's /carrier-tracking/webhook endpoint — same idea
# as grafiq-api's SHIPROCKET_WEBHOOK_TOKEN, invent your own random value.
SHIPROCKET_WEBHOOK_TOKEN=
